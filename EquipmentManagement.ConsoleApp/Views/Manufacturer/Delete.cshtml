@{
    Layout = "_Layout";
    ViewBag.Title = "Exclusão de Fabricante";
}

@using EquipmentManagement.ConsoleApp.Manufacturers
@model Manufacturer;

<form action="/Manufacturer/Delete/@Model.Id" method="post">
  <div>
    <label>Nome</label>
    <br>
    <input type="text" name="Name" value="@Model.Name" disabled>
  </div>

  <br>

  <div>
    <label>Email</label>
    <br>
    <input type="email" name="Email" value="@Model.Email" disabled>
  </div>

  <br>

  <div>
    <label>Telefone</label>
    <br>
    <input type="text" name="Phone" value="@Model.Phone" disabled>
  </div>

  <hr>

  <a href="/Manufacturer/List">Voltar</a>
  <button type="submit">Confirmar</button>
</form>