@{
    Layout = "_Layout";
    ViewBag.Title = "Cadastro de Fabricantes";
}

<form class="form" action="/Manufacturer/Register" method="post">
  
  <div class="form-field">
    <label>Nome</label>
    <br>
    <input type="text" name="Name">
  </div>

  <div class="form-field">
    <label>Email</label>
    <br>
    <input type="email" name="Email">
  </div>

  <div class="form-field">
    <label>Telefone</label>
    <br>
    <input type="text" name="Phone">
  </div>

  <div class="form-actions">
    <a href="/Manufacturer/List">Voltar</a>
    <button type="submit">Confirmar</button>
  </div>
</form>