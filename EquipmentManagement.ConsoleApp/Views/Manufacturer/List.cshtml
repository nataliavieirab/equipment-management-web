@{
    Layout = "_Layout";
    ViewBag.Title = "Listagem de Fabricantes";
}

@model List<ListManufacturersViewModel>

<a class="btn-register" asp-action="/Register">Cadastrar Novo</a>

<table class="records">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Telefone</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    @foreach (ListManufacturersViewModel m in Model)
    {
      <tr>
        <td>@m.Id</td>
        <td>@m.Name</td>
        <td>@m.Email</td>
        <td>@m.Phone</td>
      <td>
        <a href="/Manufacturer/Edit/@m.Id">Editar</a>
        <a href="/Manufacturer/Delete/@m.Id">Excluir</a>
      </td>
      </tr>
    }
  </tbody>
</table>