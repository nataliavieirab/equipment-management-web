@{
    Layout = "_Layout";
}

@using EquipmentManagement.ConsoleApp.Manufacturers
@model List<Manufacturer>

<h2>Listagem de Fabricamtes</h2>

<hr>
<a href="/Manufacturer/Register">Cadastrar Novo</a>
<hr>

<br>

<table>
  <thead>
    <tr>
      <td>ID</td>
      <td>Nome</td>
      <td>E-mail</td>
      <td>Telefone</td>
      <td>Ações</td>
    </tr>
  </thead>
  <tbody>
    @foreach (Manufacturer m in Model)
    {
      <tr>
        <td>@m.Id</td>
        <td>@m.Name</td>
        <td>@m.Email</td>
        <td>@m.Phone</td>
        <td><a href="/Manufacturer/Edit/@m.Id">Editar</a></td>
        <td><a href="/Manufacturer/Delete/@m.Id">Excluir</a></td>
      </tr>
    }
  </tbody>
</table>