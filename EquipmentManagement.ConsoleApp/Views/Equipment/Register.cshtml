@using EquipmentManagement.ConsoleApp.Models
@{
    Layout = "_Layout";
  ViewBag.Title = "Cadastro de Equipamento";

  List<ListManufacturerViewModel> manufacturers = ViewBag.Manufacturers;
}

<form class="form" action="/Equipment/Register" method="post">
  
  <div class="form-field">
    <label>Nome</label>
    <br>
    <input type="text" name="Name">
  </div>

  <div class="form-field">
    <label>Preço de Aquisição</label>
    <br>
    <input type="number" name="PurchasePrice" min="0.01" step="0.01">
  </div>

  <div class="form-field">
    <label>Data de Fabricação</label>
    <br>
    <input type="date" name="ManufacturingDate">
  </div>

    <div class="form-field">
    <label>Fabricante</label>
    <br>
    <select name="ManufacturerId">
      @foreach (ListManufacturerViewModel m in manufacturers) 
      {
        <option value="@m.Id">@m.Name</option>
      }
    </select>
  </div>

  <div class="form-actions">
    <a href="/Equipment/List">Voltar</a>
    <button type="submit">Confirmar</button>
  </div>
</form>