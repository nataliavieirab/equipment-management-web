@using EquipmentManagement.ConsoleApp.Models

@{
    Layout = "_Layout";
    ViewBag.Title = "Exclusão de Equipamento";
}

@model DeleteEquipmentViewModel;

<form class="form" action="/Equipment/Delete/@Model.Id" method="post">
  
  <p class="form-alert">Deseja realmente excluir este equipamento?</p>
  
  <div class="form-field">
    <label>Nome</label>
    <br>
    <input type="text" name="Name" value="@Model.Name" disabled>
  </div>

  <div class="form-field">
    <label>Preço de Aquisição</label>
    <br>
    <input type="text" name="PurchasePrice" min="0.01" step="0.01" value="@Model.PurchasePrice.ToString("C2")" disabled>
  </div>

  <div class="form-field">
    <label>Data de Fabricação</label>
    <br>
    <input type="text" name="ManufacturingDate" value="@Model.ManufacturingDate.ToString("dd/MM/yyyy")" disabled>
  </div>

    <div class="form-field">
    <label>Fabricante</label>
    <br>
    <input type="text" name="Manufacturer" value="@Model.Manufacturer" disabled>
  </div>

  <div class="form-actions">
    <a href="/Equipment/List">Voltar</a>
    <button type="submit">Confirmar</button>
  </div>
</form>