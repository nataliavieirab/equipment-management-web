<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="~/css/styles.css">
        <title>@ViewBag.Title - Gestão de Equipamentos</title>
    </head>
    <body>
        <nav>
            <h3>Gestão de Equipamentos</h3>

            <div class="links-navbar">
                <a href="/">Início</a> 
                <a asp-controller="Manufacturer" asp-action="List">Controle de Fabricantes</a> 
                <a asp-controller="Equipment" asp-action="List">Controle de Equipamentos</a> 
                <a asp-controller="Ticket" asp-action="List">Controle de Chamados</a> 
            </div>
        </nav>

        <header>
            <h2>@ViewBag.Title</h2>
        </header>
 
        <main>
            @RenderBody()
        </main>
    </body>
</html>